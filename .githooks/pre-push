#!/bin/sh
# Rebuild lib/ and stop the push when the committed bundle is stale.
# Enable once per clone: git config core.hooksPath .githooks
set -u

zero=0000000000000000000000000000000000000000
pending=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] || pending=1
done

[ "$pending" = 1 ] || exit 0

if [ ! -d node_modules ]; then
  echo "pre-push: node_modules is missing; run 'npm ci' first." >&2
  exit 1
fi

echo "pre-push: rebuilding lib/ to compare with the commit..."
if ! npm run build --silent >/dev/null 2>&1; then
  echo "pre-push: build failed; fix it before pushing." >&2
  exit 1
fi

if [ -n "$(git status --porcelain -- lib)" ]; then
  echo "pre-push: lib/ is stale. Commit the rebuilt bundle with its source." >&2
  echo "pre-push: run 'npm run build' and add lib/ to the same commit." >&2
  git --no-pager diff --stat -- lib >&2
  exit 1
fi
